<?xml version="1.0" encoding="UTF-8"?>
<!-- One justification per entry; each names the classes it covers, so a new site of the pattern is still reported. -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

	<!-- An inventory detector (one per request mapping), not a weakness: it names no flaw and prescribes no fix. -->
	<Match>
		<Bug pattern="SPRING_ENDPOINT"/>
		<Class name="~io\.ezeebit\.[a-z]+\.ctl\.[A-Za-z]+Ctrl"/>
	</Match>

	<!-- Constructor injection of Spring singletons: sharing the collaborator is the intent. Exact types: type takes no regex. -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP2"/>
		<Method name="&lt;init&gt;"/>
		<Or>
			<Field type="io.ezeebit.ledger.data.repo.AccountRepo"/>
			<Field type="io.ezeebit.ledger.data.repo.EntryRepo"/>
			<Field type="io.ezeebit.ledger.data.repo.JournalRepo"/>
			<Field type="io.ezeebit.conversion.data.repo.ConversionRepo"/>
			<Field type="io.ezeebit.conversion.data.repo.QuoteRepo"/>
			<Field type="io.ezeebit.conversion.service.ConversionSettler"/>
			<Field type="io.micrometer.core.instrument.MeterRegistry"/>
			<Field type="org.springframework.web.client.RestClient"/>
			<Field type="org.springframework.transaction.support.TransactionTemplate"/>
		</Or>
	</Match>

	<!-- Every argument at these calls goes through LogText.oneLine (LogTextTest); FSB cannot see that sanitiser. -->
	<Match>
		<Bug pattern="CRLF_INJECTION_LOGS"/>
		<Or>
			<And>
				<Class name="~io\.ezeebit\.(conversion|ledger)\.api\.advice\.BusinessExceptionHandler"/>
				<Method name="business"/>
			</And>
			<And>
				<Class name="io.ezeebit.conversion.outbound.ledger.LedgerClient"/>
				<Method name="call"/>
			</And>
			<And>
				<Class name="io.ezeebit.conversion.outbound.rates.RateClient"/>
				<Method name="fetch"/>
			</And>
		</Or>
	</Match>

	<!-- policy() only sees codes require() admitted as ASCII [A-Z]{3,5}; CurrencyCatalogTest proves the guard. -->
	<Match>
		<Bug pattern="IMPROPER_UNICODE"/>
		<Class name="io.ezeebit.conversion.service.CurrencyCatalog"/>
		<Method name="policy"/>
	</Match>

</FindBugsFilter>
