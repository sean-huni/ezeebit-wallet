    "/v1/merchants/{merchantId}/quotes" : {
      "post" : {
        "description" : "Exactly one of sellAmount (what leaves) or buyAmount (what arrives). Moves no money: no Idempotency-Key.",
        "operationId" : "createQuote",
        "parameters" : [ {
          "description" : "Merchant id, a UUID.",
          "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
          "in" : "path",
          "name" : "merchantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/QuoteReq"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseQuoteResp"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "AMOUNT_NOT_POSITIVE" : {
                    "value" : {
                      "code" : "AMOUNT_NOT_POSITIVE",
                      "detail" : "Amount {0} must be greater than zero.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "AMOUNT_SCALE_EXCEEDED" : {
                    "value" : {
                      "code" : "AMOUNT_SCALE_EXCEEDED",
                      "detail" : "Amount {0} has more decimals than {1} allows ({2}).",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "AMOUNT_TOO_LARGE" : {
                    "value" : {
                      "code" : "AMOUNT_TOO_LARGE",
                      "detail" : "Amount {0} has more than {1} digits before the decimal point.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
