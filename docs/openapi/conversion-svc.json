{
  "components" : {
    "schemas" : {
      "ApiResponseConversionResp" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/ConversionResp"
          }
        },
        "type" : "object"
      },
      "ApiResponseQuoteResp" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/QuoteResp"
          }
        },
        "type" : "object"
      },
      "ConversionReq" : {
        "properties" : {
          "quoteId" : {
            "description" : "From the quote answer.",
            "example" : "5e7d2c1b-9a8f-4e6d-b3c2-a1f0e9d8c7b6",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "quoteId" ],
        "type" : "object"
      },
      "ConversionResp" : {
        "properties" : {
          "appliedRate" : {
            "example" : "0.05398273",
            "type" : "string"
          },
          "buyAmount" : {
            "example" : "53.982730",
            "type" : "string"
          },
          "buyCurrency" : {
            "example" : "USDT",
            "type" : "string"
          },
          "completed" : {
            "example" : "2026-10-13T10:00:05Z",
            "format" : "date-time",
            "type" : "string"
          },
          "conversionId" : {
            "example" : "c4e8f1a2-6b3d-4e5f-9a7b-2d1c0e9f8a7b",
            "format" : "uuid",
            "type" : "string"
          },
          "created" : {
            "example" : "2026-10-13T10:00:05Z",
            "format" : "date-time",
            "type" : "string"
          },
          "merchantId" : {
            "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
            "format" : "uuid",
            "type" : "string"
          },
          "quoteId" : {
            "example" : "5e7d2c1b-9a8f-4e6d-b3c2-a1f0e9d8c7b6",
            "format" : "uuid",
            "type" : "string"
          },
          "reason" : {
            "description" : "Why a REJECTED conversion was rejected.",
            "type" : "string"
          },
          "sellAmount" : {
            "example" : "1000.00",
            "type" : "string"
          },
          "sellCurrency" : {
            "example" : "ZAR",
            "type" : "string"
          },
          "status" : {
            "description" : "COMPLETED, PENDING or REJECTED.",
            "example" : "COMPLETED",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ErrorCode" : {
        "description" : "Stable machine-readable error code.",
        "enum" : [ "AMOUNT_NOT_POSITIVE", "AMOUNT_SCALE_EXCEEDED", "AMOUNT_TOO_LARGE", "AMOUNT_TOO_SMALL", "BALANCE_LIMIT_EXCEEDED", "CONVERSION_NOT_FOUND", "CONVERSION_REJECTED", "GATEWAY_REQUIRED", "IDEMPOTENCY_KEY_MISSING", "IDEMPOTENCY_KEY_REUSED", "INSUFFICIENT_FUNDS", "INTERNAL_ERROR", "MALFORMED_REQUEST", "METHOD_NOT_ALLOWED", "NOT_FOUND", "QUOTE_ALREADY_USED", "QUOTE_EXPIRED", "QUOTE_NOT_FOUND", "RATE_REJECTED", "RATE_UNAVAILABLE", "SAME_CURRENCY", "UNKNOWN_CURRENCY", "UNSUPPORTED_API_VERSION", "UNSUPPORTED_MEDIA_TYPE", "UNSUPPORTED_PAIR", "VALIDATION_FAILED" ],
        "type" : "string"
      },
      "Problem" : {
        "description" : "RFC 9457 problem detail. `code` is stable; `detail` is localised by Accept-Language.",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ErrorCode"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "description" : "One entry per invalid field, on VALIDATION_FAILED.",
            "items" : {
              "$ref" : "#/components/schemas/Violation"
            },
            "type" : "array"
          },
          "field" : {
            "description" : "The request field a business rule refused, when one did.",
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "required" : [ "code", "status", "title" ],
        "type" : "object"
      },
      "QuoteReq" : {
        "example" : {
          "buy" : "USDT",
          "sell" : "ZAR",
          "sellAmount" : "1000.00"
        },
        "properties" : {
          "buy" : {
            "description" : "Currency that arrives.",
            "example" : "USDT",
            "type" : "string"
          },
          "buyAmount" : {
            "description" : "Exact amount to receive, a decimal string. Give this or sellAmount.",
            "pattern" : "-?\\d{1,40}(\\.\\d{1,40})?",
            "type" : "string"
          },
          "sell" : {
            "description" : "Currency that leaves the merchant.",
            "example" : "ZAR",
            "type" : "string"
          },
          "sellAmount" : {
            "description" : "Exact amount to sell, a decimal string. Give this or buyAmount.",
            "example" : "1000.00",
            "pattern" : "-?\\d{1,40}(\\.\\d{1,40})?",
            "type" : "string"
          }
        },
        "required" : [ "buy", "sell" ],
        "type" : "object"
      },
      "QuoteResp" : {
        "properties" : {
          "appliedRate" : {
            "description" : "rate after the spread: what the merchant gets.",
            "example" : "0.05398273",
            "type" : "string"
          },
          "buyAmount" : {
            "example" : "53.982730",
            "type" : "string"
          },
          "buyCurrency" : {
            "example" : "USDT",
            "type" : "string"
          },
          "expiresAt" : {
            "description" : "The quote is firm until then.",
            "example" : "2026-10-13T10:00:15Z",
            "format" : "date-time",
            "type" : "string"
          },
          "merchantId" : {
            "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
            "format" : "uuid",
            "type" : "string"
          },
          "quoteId" : {
            "example" : "5e7d2c1b-9a8f-4e6d-b3c2-a1f0e9d8c7b6",
            "format" : "uuid",
            "type" : "string"
          },
          "rate" : {
            "description" : "Market rate from the rate feed.",
            "example" : "0.054254",
            "type" : "string"
          },
          "rateTimestamp" : {
            "example" : "2026-10-13T10:00:00Z",
            "format" : "date-time",
            "type" : "string"
          },
          "sellAmount" : {
            "example" : "1000.00",
            "type" : "string"
          },
          "sellCurrency" : {
            "example" : "ZAR",
            "type" : "string"
          },
          "spreadBps" : {
            "example" : 50,
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "Violation" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Quotes and conversions between a merchant's currencies. Call it through the gateway: the server below is the gateway, and each path here is served there under /api.\nEvery error is an RFC 9457 problem detail (application/problem+json) with a stable `code`.\nBesides the answers listed per operation, the gateway itself can answer any operation with 400 INVALID_MERCHANT_ID, 400 MALFORMED_PATH, 429 RATE_LIMITED (with Retry-After), 503 RATE_LIMITER_UNAVAILABLE (with Retry-After), 503 UPSTREAM_UNAVAILABLE and 504 UPSTREAM_OUTCOME_UNKNOWN.",
    "title" : "conversion-svc public API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/v1/merchants/{merchantId}/conversions" : {
      "post" : {
        "description" : "The quote is single-use. The same Idempotency-Key with the same body answers the first answer again.",
        "operationId" : "createConversion",
        "parameters" : [ {
          "description" : "Merchant id, a UUID.",
          "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
          "in" : "path",
          "name" : "merchantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "Unique per conversion, at most 128 characters. The same key with a different body is 422.",
          "example" : "convert-1",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "maxLength" : 128,
            "minLength" : 0,
            "pattern" : "\\P{Cc}*",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ConversionReq"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseConversionResp"
                }
              }
            },
            "description" : "COMPLETED: the money moved"
          },
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseConversionResp"
                }
              }
            },
            "description" : "PENDING: the ledger's answer is not known yet; read the conversion back"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "IDEMPOTENCY_KEY_MISSING" : {
                    "value" : {
                      "code" : "IDEMPOTENCY_KEY_MISSING",
                      "detail" : "The Idempotency-Key header is required.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "MALFORMED_REQUEST" : {
                    "value" : {
                      "code" : "MALFORMED_REQUEST",
                      "detail" : "The request body is not valid JSON for this endpoint.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "VALIDATION_FAILED" : {
                    "value" : {
                      "code" : "VALIDATION_FAILED",
                      "detail" : "The request is invalid.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "VALIDATION_FAILED", "MALFORMED_REQUEST", "IDEMPOTENCY_KEY_MISSING" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Bad Request: VALIDATION_FAILED, MALFORMED_REQUEST, IDEMPOTENCY_KEY_MISSING"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "GATEWAY_REQUIRED" : {
                    "value" : {
                      "code" : "GATEWAY_REQUIRED",
                      "detail" : "This endpoint is reachable only through the gateway.",
                      "status" : 403,
                      "title" : "Forbidden"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "GATEWAY_REQUIRED" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Forbidden: GATEWAY_REQUIRED"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "QUOTE_NOT_FOUND" : {
                    "value" : {
                      "code" : "QUOTE_NOT_FOUND",
                      "detail" : "Quote {0} does not exist.",
                      "status" : 404,
                      "title" : "Not Found"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "QUOTE_NOT_FOUND" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Not Found: QUOTE_NOT_FOUND"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "CONVERSION_REJECTED" : {
                    "value" : {
                      "code" : "CONVERSION_REJECTED",
                      "detail" : "Conversion {0} was rejected: {1}.",
                      "status" : 409,
                      "title" : "Conflict"
                    }
                  },
                  "QUOTE_ALREADY_USED" : {
                    "value" : {
                      "code" : "QUOTE_ALREADY_USED",
                      "detail" : "Quote {0} has already been used.",
                      "status" : 409,
                      "title" : "Conflict"
                    }
                  },
                  "QUOTE_EXPIRED" : {
                    "value" : {
                      "code" : "QUOTE_EXPIRED",
                      "detail" : "Quote {0} has expired: request a new quote.",
                      "status" : 409,
                      "title" : "Conflict"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "QUOTE_EXPIRED", "QUOTE_ALREADY_USED", "CONVERSION_REJECTED" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Conflict: QUOTE_EXPIRED, QUOTE_ALREADY_USED, CONVERSION_REJECTED"
          },
          "415" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "UNSUPPORTED_MEDIA_TYPE" : {
                    "value" : {
                      "code" : "UNSUPPORTED_MEDIA_TYPE",
                      "detail" : "Content type {0} is not supported.",
                      "status" : 415,
                      "title" : "Unsupported Media Type"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "UNSUPPORTED_MEDIA_TYPE" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Unsupported Media Type: UNSUPPORTED_MEDIA_TYPE"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "BALANCE_LIMIT_EXCEEDED" : {
                    "value" : {
                      "code" : "BALANCE_LIMIT_EXCEEDED",
                      "detail" : "Conversion {0} was rejected: the balance it credits would pass the largest amount the ledger can hold.",
                      "status" : 422,
                      "title" : "Unprocessable Content"
                    }
                  },
                  "IDEMPOTENCY_KEY_REUSED" : {
                    "value" : {
                      "code" : "IDEMPOTENCY_KEY_REUSED",
                      "detail" : "Idempotency-Key {0} was already used with a different request.",
                      "status" : 422,
                      "title" : "Unprocessable Content"
                    }
                  },
                  "INSUFFICIENT_FUNDS" : {
                    "value" : {
                      "code" : "INSUFFICIENT_FUNDS",
                      "detail" : "Conversion {0} was rejected: the balance is too low.",
                      "status" : 422,
                      "title" : "Unprocessable Content"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "IDEMPOTENCY_KEY_REUSED", "INSUFFICIENT_FUNDS", "BALANCE_LIMIT_EXCEEDED" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Unprocessable Content: IDEMPOTENCY_KEY_REUSED, INSUFFICIENT_FUNDS, BALANCE_LIMIT_EXCEEDED"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "INTERNAL_ERROR" : {
                    "value" : {
                      "code" : "INTERNAL_ERROR",
                      "detail" : "Internal error.",
                      "status" : 500,
                      "title" : "Internal Server Error"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "INTERNAL_ERROR" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Internal Server Error: INTERNAL_ERROR"
          }
        },
        "summary" : "Accept a quote: move the money",
        "tags" : [ "Conversions" ]
      }
    },
