{
  "uid": "ezeebit-traces",
  "title": "Traces",
  "description": "One request is one trace: gateway, conversion-svc and ledger-svc, with the business spans inside. GENERATED by docker/lgtm/generate.py, do not edit: change the generator and rerun it.",
  "tags": [
    "ezeebit"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ezeebit"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Ezeebit"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Alert state changes",
        "type": "dashboard",
        "target": {
          "type": "dashboard",
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_threads_live, job)",
          "refId": "service"
        },
        "definition": "label_values(jvm_threads_live, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ]
      },
      {
        "name": "min_duration",
        "label": "Min duration",
        "type": "textbox",
        "query": "100ms",
        "current": {
          "text": "100ms",
          "value": "100ms"
        },
        "options": [
          {
            "text": "100ms",
            "value": "100ms",
            "selected": true
          }
        ]
      },
      {
        "name": "interval",
        "label": "Rate window",
        "type": "custom",
        "query": "1m,2m,5m,15m",
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          }
        ],
        "current": {
          "text": "1m",
          "value": "1m"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Trace by ID: put a trace ID in the box, then open this row",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "type": "traces",
          "title": "Trace",
          "description": "The trace named in the Trace ID box: every span from gateway-svc, conversion-svc and ledger-svc on one timeline. In a collapsed row because a trace panel with no ID is an error: fill the box (from a table below, an exemplar, or a trace_id in Logs), then open the row.",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "tempo",
                "uid": "tempo"
              },
              "queryType": "traceql",
              "query": "${trace_id}"
            }
          ],
          "gridPos": {
            "x": 0,
            "y": 1,
            "w": 24,
            "h": 16
          },
          "id": 2
        }
      ],
      "id": 1
    },
    {
      "type": "row",
      "title": "Traces and spans",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 3
    },
    {
      "type": "table",
      "title": "Merchant requests",
      "description": "Latest traces whose root is a merchant route at the gateway and that touched the selected services: one row per merchant request. Click a Trace ID to open the whole trace in Explore.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:rootName=~\"http .* /api/.*\" && resource.service.name=~\"${service:regex}\"} with (most_recent=true)",
          "limit": 20,
          "tableType": "traces",
          "spss": 10
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 9
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Traces with an error",
      "description": "Traces holding a span with an error status (an exception recorded on it) or a 5xx answer. Empty is the healthy state.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && (status=error || span.status=~\"5..\")} with (most_recent=true)",
          "limit": 20,
          "tableType": "traces",
          "spss": 10
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "id": 5
    },
    {
      "type": "table",
      "title": "Slow merchant requests",
      "description": "Merchant requests longer than the Min duration box. Empty: none was.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:rootName=~\"http .* /api/.*\" && resource.service.name=~\"${service:regex}\" && duration > ${min_duration}} with (most_recent=true)",
          "limit": 20,
          "tableType": "traces",
          "spss": 10
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Business spans",
      "description": "The spans each service opens around a money step (quote, conversion accept, deposit, ledger posting) with their bounded attributes: pair, currency, outcome, code; never a merchant or an amount. 'rate limit' and 'sweep' spans are in every merchant trace and sweeper run.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && name=~\"quote|conversion accept|deposit|ledger posting\"} | select(span.pair, span.currency, span.outcome, span.code, span.reason, span.detail, span.operation) with (most_recent=true)",
          "limit": 30,
          "tableType": "spans",
          "spss": 10
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "id": 7
    },
    {
      "type": "nodeGraph",
      "title": "Service map",
      "description": "Calls between services, derived by Tempo from the spans (traces_service_graph metrics). An arrow is a client span in one service whose server span is in another; the rate feed appears as the host conversion-svc calls.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap",
          "serviceMapQuery": "{}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 12
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Span rate by service and status",
      "description": "Spans per second from Tempo's span metrics, by status code: a cross-check of the services' own request counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, status_code) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$interval]))",
          "legendFormat": "{{service}} {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 8
      },
      "id": 9
    }
  ]
}
