{
  "uid": "ezeebit-fleet",
  "title": "Fleet Overview",
  "description": "Every service's health, RED metrics, dependencies, limiter, pool and JVM. GENERATED by docker/lgtm/generate.py, do not edit: change the generator and rerun it.",
  "tags": [
    "ezeebit"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ezeebit"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Ezeebit"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Alert state changes",
        "type": "dashboard",
        "target": {
          "type": "dashboard",
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_threads_live, job)",
          "refId": "service"
        },
        "definition": "label_values(jvm_threads_live, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "interval",
        "label": "Rate window",
        "type": "custom",
        "query": "1m,2m,5m,15m",
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          }
        ],
        "current": {
          "text": "1m",
          "value": "1m"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Alive",
      "description": "UP: the service exported metrics in the last 30s. DOWN: seen in the last hour, silent for 30s. A service never seen in the last hour is not listed; ServiceDown still pages for it. Click a tile for its logs and traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job) (present_over_time(jvm_threads_live{job=~\"$service\"}[30s])) or (max by (job) (present_over_time(jvm_threads_live{job=~\"$service\"}[1h])) * 0)",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Logs for ${__field.labels.job}",
              "url": "/d/ezeebit-logs/logs?var-service=${__field.labels.job}&${__url_time_range}"
            },
            {
              "title": "Traces for ${__field.labels.job}",
              "url": "/d/ezeebit-traces/traces?var-service=${__field.labels.job}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 10,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "JVMs per service",
      "description": "Metric identity: each JVM is its own series (instance = host:port), so this counts the instances exporting under each service. A number below the replicas running means two JVMs share one series and every rate panel above is wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (job) (group by (job, instance) (jvm_threads_live{job=~\"$service\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
