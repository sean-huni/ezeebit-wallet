{
  "uid": "ezeebit-logs",
  "title": "Logs",
  "tags": ["ezeebit"],
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "service", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "query": {"query": "label_values(jvm_threads_live, job)", "refId": "service"},
     "refresh": 2, "multi": true, "includeAll": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "level", "type": "custom", "query": "error,warn,info,debug",
     "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "logs", "title": "Logs", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 20},
     "description": "Each line carries trace_id when it was logged inside a request; open it to jump to the trace.",
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "{service_name=~\"${service:regex}\"} | detected_level=~\"${level:regex}\""}],
     "options": {"showTime": true, "sortOrder": "Descending", "enableLogDetails": true}}
  ]
}
