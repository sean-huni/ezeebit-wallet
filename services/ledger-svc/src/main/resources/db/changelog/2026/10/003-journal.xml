<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-journal-table" author="ledger-svc">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="journal"/></not></preConditions>
        <createTable tableName="journal">
            <column name="id" type="UUID"><constraints primaryKey="true" primaryKeyName="pk_journal"/></column>
            <column name="merchant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="type" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="idempotency_key" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="request_hash" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="reference" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="created" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <!-- The idempotency arbiter: one posting per (merchant, type, key), whoever arrives first. -->
        <addUniqueConstraint tableName="journal" columnNames="merchant_id, type, idempotency_key" constraintName="uq_journal_idempotency"/>
        <rollback><dropTable tableName="journal"/></rollback>
    </changeSet>

    <changeSet id="003-journal-checks" author="ledger-svc">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM pg_constraint WHERE conname IN ('ck_journal_type', 'ck_journal_status')</sqlCheck>
        </preConditions>
        <!-- LIQUIBASE-SQL-EXCEPTION: Liquibase has no typed tag for CHECK constraints -->
        <sql>ALTER TABLE journal ADD CONSTRAINT ck_journal_type CHECK (type IN ('DEPOSIT'));
ALTER TABLE journal ADD CONSTRAINT ck_journal_status CHECK (status IN ('POSTED'));</sql>
        <rollback>
            <!-- LIQUIBASE-SQL-EXCEPTION: Liquibase has no typed tag for CHECK constraints -->
            <sql>ALTER TABLE journal DROP CONSTRAINT ck_journal_type, DROP CONSTRAINT ck_journal_status;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
