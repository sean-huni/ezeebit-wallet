    {
      "type": "timeseries",
      "title": "Deposits per minute by currency and outcome",
      "description": "posted, replayed (same Idempotency-Key, answered from the stored rows) or refused with a code. 'unknown' currency: refused before the currency was known.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (currency, outcome, code) (rate(ezeebit_ledger_deposits_total{currency=~\"$currency\", outcome=~\"$outcome\"}[$interval])) * 60",
          "legendFormat": "{{currency}} {{outcome}} {{code}}",
          "range": true
        }
      ],
      "fieldConfig": {
