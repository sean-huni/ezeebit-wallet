{
  "uid": "ezeebit-logs",
  "title": "Logs",
  "description": "Every service's logs, by level, text and trace. GENERATED by docker/lgtm/generate.py, do not edit: change the generator and rerun it.",
  "tags": [
    "ezeebit"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ezeebit"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Ezeebit"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Alert state changes",
        "type": "dashboard",
        "target": {
          "type": "dashboard",
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_threads_live, job)",
          "refId": "service"
        },
        "definition": "label_values(jvm_threads_live, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "options": [
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "warn",
            "value": "warn",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ],
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
        ]
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines by service and level",
      "description": "Lines per interval, so a burst of warnings stands out before reading any of them.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\"${service:regex}\"} | detected_level=~\"${level:regex}\" | trace_id=~\"${trace_id}\" |~ \"(?i)${search}\" [$__auto]))",
          "legendFormat": "{{service_name}} {{detected_level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "id": 1
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "Every line written inside a request carries trace_id and span_id. Expand a line and click its trace_id to open the trace in Tempo. The Trace ID box narrows this panel to one request.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"${service:regex}\"} | detected_level=~\"${level:regex}\" | trace_id=~\"${trace_id}\" |~ \"(?i)${search}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 16
      },
      "id": 2
    },
    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Only WARN and ERROR, whatever the level box says. Empty is the healthy state.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{service_name=~\"${service:regex}\"} | detected_level=~\"warn|error\" |~ \"(?i)${search}\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "id": 3
    }
  ]
}
