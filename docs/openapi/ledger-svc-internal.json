                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "INTERNAL_ERROR" ],
                        "type" : "string"
                      }
