#!/usr/bin/env bash
# Test stub: answers only the exact `docker ps` the guard runs, printing STUB_CONTAINERS (one container per line);
# STUB_DOCKER_DOWN=1 answers as an unreachable daemon does. Any other call exits 125, so a changed flag fails the suite.
FORMAT='{{.Names}}|{{.State}}|{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.working_dir"}}|{{.Label "io.x-k8s.kind.cluster"}}|{{.Ports}}'
if [[ $# -ne 5 || $1 != ps || $2 != -a || $3 != --no-trunc || $4 != --format || $5 != "$FORMAT" ]]; then
  printf 'docker stub: unexpected call: docker %s\n' "$*" >&2
  exit 125
fi
if [[ ${STUB_DOCKER_DOWN:-0} == 1 ]]; then
  printf 'Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?\n' >&2
  exit 1
fi
[[ -n ${STUB_CONTAINERS:-} ]] && printf '%s\n' "$STUB_CONTAINERS"
exit 0
