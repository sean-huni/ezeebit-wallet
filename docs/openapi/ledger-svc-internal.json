{
  "components" : {
    "schemas" : {
      "ApiResponseConversionPostingResp" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/ConversionPostingResp"
          }
        },
        "type" : "object"
      },
      "ApiResponseDepositResp" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/DepositResp"
          }
        },
        "type" : "object"
      },
      "ConversionPostingReq" : {
        "properties" : {
          "buyAmount" : {
            "example" : "53.982730",
            "pattern" : "-?\\d{1,40}(\\.\\d{1,40})?",
            "type" : "string"
          },
          "buyCurrency" : {
            "example" : "USDT",
            "type" : "string"
          },
          "conversionId" : {
            "example" : "c4e8f1a2-6b3d-4e5f-9a7b-2d1c0e9f8a7b",
            "format" : "uuid",
            "type" : "string"
          },
          "deadline" : {
            "description" : "Checked against the ledger's clock; after it the posting is refused.",
            "example" : "2026-10-13T10:00:15Z",
            "format" : "date-time",
            "type" : "string"
          },
          "merchantId" : {
            "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
            "format" : "uuid",
            "type" : "string"
          },
          "sellAmount" : {
            "example" : "1000.00",
            "pattern" : "-?\\d{1,40}(\\.\\d{1,40})?",
            "type" : "string"
          },
          "sellCurrency" : {
            "example" : "ZAR",
            "type" : "string"
          }
        },
        "required" : [ "buyAmount", "buyCurrency", "conversionId", "deadline", "merchantId", "sellAmount", "sellCurrency" ],
        "type" : "object"
      },
      "ConversionPostingResp" : {
        "properties" : {
          "buyAmount" : {
            "type" : "string"
          },
          "buyCurrency" : {
            "type" : "string"
          },
          "conversionId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "created" : {
            "format" : "date-time",
            "type" : "string"
          },
          "journalId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "merchantId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "reason" : {
            "description" : "Why a REFUSED posting was refused.",
            "type" : "string"
          },
          "sellAmount" : {
            "type" : "string"
          },
          "sellCurrency" : {
            "type" : "string"
          },
          "status" : {
            "description" : "POSTED, VOID or REFUSED.",
            "example" : "POSTED",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "DepositReq" : {
        "properties" : {
          "amount" : {
            "description" : "A decimal string, never a JSON number.",
            "example" : "1500.00",
            "pattern" : "-?\\d{1,40}(\\.\\d{1,40})?",
            "type" : "string"
          },
          "currency" : {
            "example" : "ZAR",
            "type" : "string"
          },
          "merchantId" : {
            "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
            "format" : "uuid",
            "type" : "string"
          },
          "reference" : {
            "example" : "rail transfer 1",
            "maxLength" : 128,
            "minLength" : 0,
            "pattern" : "\\P{Cc}*",
            "type" : "string"
          }
        },
        "required" : [ "amount", "currency", "merchantId", "reference" ],
        "type" : "object"
      },
      "DepositResp" : {
        "properties" : {
          "amount" : {
            "example" : "1500.00",
            "type" : "string"
          },
          "balanceAfter" : {
            "example" : "1500.00",
            "type" : "string"
          },
          "created" : {
            "example" : "2026-10-13T10:00:00Z",
            "format" : "date-time",
            "type" : "string"
          },
          "currency" : {
            "example" : "ZAR",
            "type" : "string"
          },
          "journalId" : {
            "example" : "9b1d4e2a-7c3f-4a5b-8e6d-1f2a3b4c5d6e",
            "format" : "uuid",
            "type" : "string"
          },
          "merchantId" : {
            "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
            "format" : "uuid",
            "type" : "string"
          },
          "reference" : {
            "example" : "rail transfer 1",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ErrorCode" : {
        "description" : "Stable machine-readable error code.",
        "enum" : [ "AMOUNT_NOT_POSITIVE", "AMOUNT_SCALE_EXCEEDED", "AMOUNT_TOO_LARGE", "BALANCE_LIMIT_EXCEEDED", "CONVERSION_ALREADY_POSTED", "CONVERSION_VOIDED", "CURRENCY_MISMATCH", "GATEWAY_REQUIRED", "IDEMPOTENCY_KEY_MISSING", "IDEMPOTENCY_KEY_REUSED", "INSUFFICIENT_FUNDS", "INTERNAL_ERROR", "MALFORMED_REQUEST", "METHOD_NOT_ALLOWED", "NOT_FOUND", "POSTING_DEADLINE_PASSED", "POSTING_NOT_FOUND", "SAME_CURRENCY", "UNBALANCED_POSTING", "UNKNOWN_CURRENCY", "UNSUPPORTED_API_VERSION", "UNSUPPORTED_MEDIA_TYPE", "VALIDATION_FAILED" ],
        "type" : "string"
      },
      "Problem" : {
        "description" : "RFC 9457 problem detail. `code` is stable; `detail` is localised by Accept-Language.",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ErrorCode"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "description" : "One entry per invalid field, on VALIDATION_FAILED.",
            "items" : {
              "$ref" : "#/components/schemas/Violation"
            },
            "type" : "array"
          },
          "field" : {
            "description" : "The request field a business rule refused, when one did.",
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "required" : [ "code", "status", "title" ],
        "type" : "object"
      },
      "Violation" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "VoidReq" : {
        "properties" : {
          "merchantId" : {
            "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "merchantId" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Service-to-service calls: deposits from the money-in rail, conversion postings from conversion-svc. Never routed by the gateway; the service listens on loopback.",
    "title" : "ledger-svc internal API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/v1/conversion-postings" : {
      "post" : {
        "description" : "Idempotent on conversionId. A funds or limit refusal is recorded as REFUSED and replayed for the same body.",
        "operationId" : "postConversion",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ConversionPostingReq"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseConversionPostingResp"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "AMOUNT_NOT_POSITIVE" : {
                    "value" : {
                      "code" : "AMOUNT_NOT_POSITIVE",
                      "detail" : "Amount {0} must be greater than zero.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "AMOUNT_SCALE_EXCEEDED" : {
                    "value" : {
                      "code" : "AMOUNT_SCALE_EXCEEDED",
                      "detail" : "Amount {0} has more decimals than {1} allows ({2}).",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "AMOUNT_TOO_LARGE" : {
                    "value" : {
                      "code" : "AMOUNT_TOO_LARGE",
                      "detail" : "Amount {0} has more than {1} digits before the decimal point.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "MALFORMED_REQUEST" : {
                    "value" : {
                      "code" : "MALFORMED_REQUEST",
                      "detail" : "The request body is not valid JSON for this endpoint.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "SAME_CURRENCY" : {
                    "value" : {
                      "code" : "SAME_CURRENCY",
                      "detail" : "A conversion needs two different currencies, not {0} twice.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "UNKNOWN_CURRENCY" : {
                    "value" : {
                      "code" : "UNKNOWN_CURRENCY",
                      "detail" : "Currency {0} is not supported.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  },
                  "VALIDATION_FAILED" : {
                    "value" : {
                      "code" : "VALIDATION_FAILED",
                      "detail" : "The request is invalid.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "VALIDATION_FAILED", "MALFORMED_REQUEST", "UNKNOWN_CURRENCY", "AMOUNT_SCALE_EXCEEDED", "AMOUNT_NOT_POSITIVE", "AMOUNT_TOO_LARGE", "SAME_CURRENCY" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Bad Request: VALIDATION_FAILED, MALFORMED_REQUEST, UNKNOWN_CURRENCY, AMOUNT_SCALE_EXCEEDED, AMOUNT_NOT_POSITIVE, AMOUNT_TOO_LARGE, SAME_CURRENCY"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "CONVERSION_VOIDED" : {
                    "value" : {
                      "code" : "CONVERSION_VOIDED",
                      "detail" : "Conversion {0} was voided and can no longer be posted.",
                      "status" : 409,
                      "title" : "Conflict"
                    }
                  },
                  "POSTING_DEADLINE_PASSED" : {
                    "value" : {
                      "code" : "POSTING_DEADLINE_PASSED",
                      "detail" : "The conversion posting deadline {0} has passed.",
                      "status" : 409,
                      "title" : "Conflict"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "POSTING_DEADLINE_PASSED", "CONVERSION_VOIDED" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Conflict: POSTING_DEADLINE_PASSED, CONVERSION_VOIDED"
          },
          "415" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "UNSUPPORTED_MEDIA_TYPE" : {
                    "value" : {
                      "code" : "UNSUPPORTED_MEDIA_TYPE",
                      "detail" : "Content type {0} is not supported.",
                      "status" : 415,
                      "title" : "Unsupported Media Type"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "UNSUPPORTED_MEDIA_TYPE" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Unsupported Media Type: UNSUPPORTED_MEDIA_TYPE"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "BALANCE_LIMIT_EXCEEDED" : {
                    "value" : {
                      "code" : "BALANCE_LIMIT_EXCEEDED",
                      "detail" : "The {0} balance would exceed the largest amount the ledger can hold.",
                      "status" : 422,
                      "title" : "Unprocessable Content"
                    }
                  },
                  "IDEMPOTENCY_KEY_REUSED" : {
                    "value" : {
                      "code" : "IDEMPOTENCY_KEY_REUSED",
                      "detail" : "Idempotency-Key {0} was already used with a different request.",
                      "status" : 422,
                      "title" : "Unprocessable Content"
                    }
                  },
                  "INSUFFICIENT_FUNDS" : {
                    "value" : {
                      "code" : "INSUFFICIENT_FUNDS",
                      "detail" : "The {0} balance is too low for this conversion.",
                      "status" : 422,
                      "title" : "Unprocessable Content"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "IDEMPOTENCY_KEY_REUSED", "INSUFFICIENT_FUNDS", "BALANCE_LIMIT_EXCEEDED" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Unprocessable Content: IDEMPOTENCY_KEY_REUSED, INSUFFICIENT_FUNDS, BALANCE_LIMIT_EXCEEDED"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "CURRENCY_MISMATCH" : {
                    "value" : {
                      "code" : "CURRENCY_MISMATCH",
                      "detail" : "Currencies {0} and {1} cannot be combined.",
                      "status" : 500,
                      "title" : "Internal Server Error"
                    }
                  },
                  "INTERNAL_ERROR" : {
                    "value" : {
                      "code" : "INTERNAL_ERROR",
                      "detail" : "Internal error.",
                      "status" : 500,
                      "title" : "Internal Server Error"
                    }
                  },
                  "UNBALANCED_POSTING" : {
                    "value" : {
                      "code" : "UNBALANCED_POSTING",
                      "detail" : "The posting does not balance.",
                      "status" : 500,
                      "title" : "Internal Server Error"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "CURRENCY_MISMATCH", "UNBALANCED_POSTING", "INTERNAL_ERROR" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Internal Server Error: CURRENCY_MISMATCH, UNBALANCED_POSTING, INTERNAL_ERROR"
          }
        },
        "summary" : "Post both legs of a conversion before its deadline",
        "tags" : [ "Conversion postings" ]
      }
    },
    "/internal/v1/conversion-postings/{conversionId}" : {
      "get" : {
        "description" : "Status POSTED, VOID, or REFUSED with its reason. Read by the conversion sweeper.",
        "operationId" : "findConversionPosting",
        "parameters" : [ {
          "in" : "path",
          "name" : "conversionId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "Merchant id, a UUID.",
          "example" : "3f2c8a10-5b7e-4c1d-9a2e-6d4f8b0c1e27",
          "in" : "query",
          "name" : "merchantId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseConversionPostingResp"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "VALIDATION_FAILED" : {
                    "value" : {
                      "code" : "VALIDATION_FAILED",
                      "detail" : "The request is invalid.",
                      "status" : 400,
                      "title" : "Bad Request"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "VALIDATION_FAILED" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Bad Request: VALIDATION_FAILED"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "POSTING_NOT_FOUND" : {
                    "value" : {
                      "code" : "POSTING_NOT_FOUND",
                      "detail" : "No posting is recorded for conversion {0}.",
                      "status" : 404,
                      "title" : "Not Found"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "POSTING_NOT_FOUND" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Not Found: POSTING_NOT_FOUND"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "examples" : {
                  "INTERNAL_ERROR" : {
                    "value" : {
                      "code" : "INTERNAL_ERROR",
                      "detail" : "Internal error.",
                      "status" : 500,
                      "title" : "Internal Server Error"
                    }
                  }
                },
                "schema" : {
                  "allOf" : [ {
                    "$ref" : "#/components/schemas/Problem"
                  }, {
                    "properties" : {
                      "code" : {
                        "enum" : [ "INTERNAL_ERROR" ],
                        "type" : "string"
                      }
                    },
                    "type" : "object"
                  } ]
                }
              }
            },
            "description" : "Internal Server Error: INTERNAL_ERROR"
          }
        },
        "summary" : "What the ledger recorded for a conversion",
        "tags" : [ "Conversion postings" ]
      }
    },
