<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Shaped to the code this repository already writes: tab indentation, static imports first, then java.*. -->
<module name="Checker">
	<property name="severity" value="error"/>
	<property name="fileExtensions" value="java"/>
	<property name="charset" value="UTF-8"/>
	<property name="tabWidth" value="4"/>

	<!-- protoc output (build/generated): it is regenerated on every build, so a style finding there has no fix. -->
	<module name="BeforeExecutionExclusionFileFilter">
		<property name="fileNamePattern" value="[\\/]build[\\/]generated[\\/]"/>
	</module>
	<module name="SuppressionSingleFilter">
		<property name="id" value="illegalCatchMain"/>
		<property name="files" value="[\\/]src[\\/](test|acceptanceTest)[\\/]"/>
	</module>
	<!-- The edge limiter's last fail-closed line: an unclassified failure must become a counted 503, never a 500. -->
	<module name="SuppressionSingleFilter">
		<property name="id" value="illegalCatchMain"/>
		<property name="files" value="[\\/]gateway[\\/]api[\\/]filter[\\/]RateLimitFilter\.java$"/>
	</module>

	<module name="NewlineAtEndOfFile"/>
	<module name="LineLength">
		<property name="max" value="140"/>
		<property name="ignorePattern" value="^\s*(package|import)\s|^\s*\*\s*(https?|@see)"/>
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="message" value="Trailing whitespace."/>
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="^\t* +[^ *]"/>
		<property name="message" value="Indent with tabs, not spaces."/>
	</module>

	<module name="TreeWalker">
		<module name="AvoidStarImport"/>
		<module name="IllegalImport"/>
		<module name="RedundantImport"/>
		<module name="UnusedImports">
			<property name="processJavadoc" value="true"/>
		</module>
		<module name="CustomImportOrder">
			<property name="customImportOrderRules" value="STATIC###STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE"/>
			<property name="standardPackageRegExp" value="^(java|javax)\."/>
			<property name="sortImportsInGroupAlphabetically" value="true"/>
			<property name="separateLineBetweenGroups" value="true"/>
		</module>

		<module name="CovariantEquals"/>
		<module name="EqualsHashCode"/>
		<module name="StringLiteralEquality"/>
		<module name="FallThrough"/>
		<module name="DefaultComesLast"/>
		<module name="MissingSwitchDefault"/>
		<module name="EmptyStatement"/>
		<module name="EmptyCatchBlock"/>
		<module name="SimplifyBooleanExpression"/>
		<module name="SimplifyBooleanReturn"/>
		<module name="OneStatementPerLine"/>
		<module name="MultipleVariableDeclarations"/>
		<module name="NoFinalizer"/>
		<module name="EqualsAvoidNull"/>
		<module name="ModifiedControlVariable"/>
		<module name="IllegalCatch">
			<property name="id" value="illegalCatchMain"/>
		</module>
		<!-- Tests may catch Exception to assert on it; Error and Throwable stay banned everywhere. -->
		<module name="IllegalCatch">
			<property name="id" value="illegalCatchTest"/>
			<property name="illegalClassNames" value="Error, Throwable, java.lang.Error, java.lang.Throwable"/>
		</module>
		<!-- Spring and Cucumber instantiate these configuration classes, so they cannot hide the constructor. -->
		<module name="HideUtilityClassConstructor">
			<property name="ignoreAnnotatedBy" value="SpringBootApplication, CucumberContextConfiguration"/>
		</module>
		<module name="FinalClass"/>
		<module name="VisibilityModifier">
			<property name="protectedAllowed" value="false"/>
		</module>
		<module name="FinalParameters"/>

		<module name="NeedBraces"/>
		<module name="LeftCurly"/>
		<!-- The tree writes catch, else and finally on their own line after the closing brace. -->
		<module name="RightCurly">
			<property name="option" value="alone_or_singleline"/>
			<property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE"/>
		</module>
		<module name="RightCurly">
			<property name="option" value="alone"/>
			<property name="tokens" value="CLASS_DEF, METHOD_DEF, CTOR_DEF, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT"/>
		</module>
		<module name="EmptyBlock">
			<property name="option" value="text"/>
		</module>
		<module name="UpperEll"/>
		<module name="ArrayTypeStyle"/>
		<module name="ModifierOrder"/>
		<module name="RedundantModifier"/>
		<module name="OuterTypeFilename"/>
		<module name="OneTopLevelClass"/>
		<module name="WhitespaceAround"/>
		<module name="WhitespaceAfter"/>
		<module name="NoWhitespaceBefore"/>
		<module name="MethodParamPad"/>
		<module name="ParenPad"/>
		<module name="Indentation">
			<property name="basicOffset" value="4"/>
			<property name="caseIndent" value="4"/>
			<property name="lineWrappingIndentation" value="8"/>
			<property name="forceStrictCondition" value="false"/>
		</module>

		<module name="PackageName">
			<property name="format" value="^io\.ezeebit(\.[a-z][a-z0-9]*)*$"/>
		</module>
		<module name="TypeName"/>
		<module name="MethodName"/>
		<module name="MemberName"/>
		<module name="ParameterName"/>
		<module name="LambdaParameterName"/>
		<module name="LocalVariableName"/>
		<module name="LocalFinalVariableName"/>
		<module name="StaticVariableName"/>
		<module name="ConstantName">
			<property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
		</module>
		<module name="ClassTypeParameterName"/>
		<module name="MethodTypeParameterName"/>
	</module>
</module>
