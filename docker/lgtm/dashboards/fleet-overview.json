{
  "uid": "ezeebit-fleet",
  "title": "Fleet Overview",
  "tags": ["ezeebit"],
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": [
    {"name": "service", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "query": {"query": "label_values(jvm_threads_live, job)", "refId": "service"},
     "refresh": 2, "multi": true, "includeAll": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Alive", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
     "description": "UP: exported metrics in the last 30s. DOWN: seen in the last hour, silent for 30s. A service never seen in the last hour is not listed; ServiceDown still pages for it.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "instant": true, "legendFormat": "{{job}}",
       "expr": "count by (job) (present_over_time(jvm_threads_live{job=~\"$service\"}[30s])) or (count by (job) (present_over_time(jvm_threads_live{job=~\"$service\"}[1h])) * 0)"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name",
       "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {
       "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 2, "type": "timeseries", "title": "Request rate", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{job}}",
       "expr": "sum by (job) (rate(http_server_requests_milliseconds_count{job=~\"$service\"}[1m]))"}],
     "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 3, "type": "timeseries", "title": "5xx error ratio", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "description": "Share of requests answered 5xx. Empty means no 5xx in the window, which is the healthy state. HighErrorRate fires above 5% for 2m.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{job}}",
       "expr": "sum by (job) (rate(http_server_requests_milliseconds_count{job=~\"$service\", status=~\"5..\"}[1m])) / sum by (job) (rate(http_server_requests_milliseconds_count{job=~\"$service\"}[1m]))"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}}},
    {"id": 4, "type": "timeseries", "title": "p95 latency", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{job}}",
       "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_milliseconds_bucket{job=~\"$service\"}[1m])))"}],
     "fieldConfig": {"defaults": {"unit": "ms"}}},
    {"id": 5, "type": "timeseries", "title": "JVM heap used", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{job}}",
       "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"$service\", area=\"heap\"})"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 6, "type": "row", "title": "Money", "collapsed": false, "gridPos": {"x": 0, "y": 20, "w": 24, "h": 1}, "panels": []},
    {"id": 7, "type": "timeseries", "title": "Deposits per minute by currency", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8},
     "description": "Every deposit answer from the ledger: posted, replayed (same key, same body) or refused with its code, summed over replicas. Balance-limit refusals are code BALANCE_LIMIT_EXCEEDED. Requests refused before the service (malformed JSON, a missing field) are not counted. A deposit refused for an unknown currency shows currency 'unknown'.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{currency}} {{outcome}} {{code}}",
       "expr": "sum by (currency, outcome, code) (rate(ezeebit_ledger_deposits_total[2m])) * 60"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}}},
    {"id": 8, "type": "timeseries", "title": "Conversions by outcome", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8},
     "description": "Per minute. conversion-svc: each conversion counted once when it is settled COMPLETED or REJECTED (with reason), and PENDING when the first ledger answer left it open. ledger: every conversion-posting answer by outcome and refusal code; a replayed refusal counts again.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{status}} {{reason}}",
       "expr": "sum by (status, reason) (rate(ezeebit_conversion_outcomes_total[5m])) * 60"},
       {"refId": "B", "legendFormat": "ledger {{outcome}} {{code}}",
       "expr": "sum by (outcome, code) (rate(ezeebit_ledger_conversion_postings_total[5m])) * 60"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}}},
    {"id": 9, "type": "timeseries", "title": "Quote refusals per minute by reason", "gridPos": {"x": 0, "y": 29, "w": 12, "h": 8},
     "description": "Quotes refused by code; RATE_REJECTED carries the rate rule it broke (RATE_STALE, RATE_OUT_OF_BAND, RATE_JUMP, RATE_MALFORMED, RATE_NOT_POSITIVE). RateFeedRefusing fires per pair on RATE_UNAVAILABLE and RATE_REJECTED. Empty means no quote was ever refused since the services started.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{reason}} {{detail}}",
       "expr": "sum by (reason, detail) (rate(ezeebit_conversion_quotes_total{outcome=\"refused\"}[2m])) * 60"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}}},
    {"id": 10, "type": "timeseries", "title": "Rate service p95 latency", "gridPos": {"x": 12, "y": 29, "w": 12, "h": 8},
     "description": "conversion-svc's calls to the exchange-rate service, by outcome: answered, unavailable (timeout, refused connection, error status), unreadable. Buckets from 25 ms to 5 s; the client gives up at about 4 s.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{outcome}}",
       "expr": "histogram_quantile(0.95, sum by (outcome, le) (rate(ezeebit_conversion_rate_calls_milliseconds_bucket[2m])))"}],
     "fieldConfig": {"defaults": {"unit": "ms"}}},
    {"id": 11, "type": "stat", "title": "Overdue PENDING conversions", "gridPos": {"x": 0, "y": 37, "w": 12, "h": 8},
     "description": "PENDING conversions past their deadline plus the maximum transaction time: due for the sweeper. Read from the database, so every replica reports the same number: max(), never sum(). Briefly non-zero between sweeps is normal; non-zero for 5m fires ConversionsStuckPending.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "instant": true, "expr": "max(ezeebit_conversion_pending_overdue)"}],
     "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}},
    {"id": 12, "type": "timeseries", "title": "Sweeper actions", "gridPos": {"x": 12, "y": 37, "w": 12, "h": 8},
     "description": "What the sweeper did with each overdue PENDING conversion in the last 5m: completed (the ledger had posted it), voided, refused (the ledger had recorded a refusal), unresolved (no answer from the ledger; retried next run). Empty means the sweeper has had nothing to resolve since the services started.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{action}}",
       "expr": "sum by (action) (increase(ezeebit_conversion_sweeps_total[5m]))"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}}}
  ]
}
